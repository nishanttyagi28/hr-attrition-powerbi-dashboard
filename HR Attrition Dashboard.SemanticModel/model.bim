        "measures": [
          {
            "name": "Total Employees",
            "displayFolder": "KPIs",
            "expression": "COUNTROWS ( HR )",
            "formatString": "#,0",
            "lineageTag": "76b8ba3d-b882-42d1-b942-be364eba4969"
          },
          {
            "name": "Attrited Employees",
            "displayFolder": "KPIs",
            "expression": "SUM ( HR[AttritionFlag] )",
            "formatString": "#,0",
            "lineageTag": "ae238e32-b84a-4a86-a06e-c4dd4dbc1c97"
          },
          {
            "name": "Active Employees",
            "displayFolder": "KPIs",
            "expression": "[Total Employees] - [Attrited Employees]",
            "formatString": "#,0",
            "lineageTag": "6ccb7734-5ca8-49e2-902d-da87f149822c"
          },
          {
            "name": "Attrition Rate %",
            "displayFolder": "KPIs",
            "expression": "DIVIDE ( [Attrited Employees], [Total Employees] )",
            "formatString": "0.0%",
            "lineageTag": "f5153108-2c7e-4145-acd3-6e5c7b97b38d"
          },
          {
            "name": "Retention Rate %",
            "displayFolder": "KPIs",
            "expression": "1 - [Attrition Rate %]",
            "formatString": "0.0%",
            "lineageTag": "34df6e67-fffc-4db6-ad2c-5678a91ac58f"
          },
          {
            "name": "Avg Monthly Income",
            "displayFolder": "KPIs",
            "expression": "AVERAGE ( HR[MonthlyIncome] )",
            "formatString": "$#,0",
            "lineageTag": "c9ef360e-6cc4-40e2-b8a2-957bfe52d219"
          },
          {
            "name": "Avg Age",
            "displayFolder": "KPIs",
            "expression": "AVERAGE ( HR[Age] )",
            "formatString": "0.0",
            "lineageTag": "0218139c-6674-4169-a0c3-c2d968b3afff"
          },
          {
            "name": "Avg Years at Company",
            "displayFolder": "KPIs",
            "expression": "AVERAGE ( HR[YearsAtCompany] )",
            "formatString": "0.0",
            "lineageTag": "135f34ad-7496-4229-943c-f289d835d810"
          },
          {
            "name": "Overtime Attrition Rate",
            "displayFolder": "KPIs",
            "expression": "CALCULATE ( [Attrition Rate %], HR[OverTime] = \"Yes\" )",
            "formatString": "0.0%",
            "lineageTag": "058031f5-41ac-4af8-acbf-0d9cc121fc9d"
          },
          {
            "name": "Non-Overtime Attrition Rate",
            "displayFolder": "KPIs",
            "expression": "CALCULATE ( [Attrition Rate %], HR[OverTime] = \"No\" )",
            "formatString": "0.0%",
            "lineageTag": "c3cf5070-61f1-4590-9c36-bfeea2cfac57"
          },
          {
            "name": "Avg Job Satisfaction",
            "displayFolder": "KPIs",
            "expression": "AVERAGE ( HR[JobSatisfaction] )",
            "formatString": "0.00",
            "lineageTag": "931deff5-42fc-4d51-9421-f1c1c1ed1269"
          },
          {
            "name": "Avg Income - Attrited",
            "displayFolder": "KPIs",
            "expression": "CALCULATE ( [Avg Monthly Income], HR[Attrition] = \"Yes\" )",
            "formatString": "$#,0",
            "lineageTag": "141b28ae-a958-4808-a195-d5ed652f9a7f"
          },
          {
            "name": "Avg Income - Active",
            "displayFolder": "KPIs",
            "expression": "CALCULATE ( [Avg Monthly Income], HR[Attrition] = \"No\" )",
            "formatString": "$#,0",
            "lineageTag": "bf770921-aa88-4949-b24a-7b01b7c70af9"
          }
        ],
        "partitions": [
          {
            "name": "HR",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"C:\\Users\\Admin\\Documents\\HR-Attrition-Dashboard\\data\\WA_Fn-UseC_-HR-Employee-Attrition.csv\"), [Delimiter=\",\", Columns=35, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"Age\", Int64.Type}, {\"Attrition\", type text}, {\"BusinessTravel\", type text}, {\"DailyRate\", Int64.Type}, {\"Department\", type text}, {\"DistanceFromHome\", Int64.Type}, {\"Education\", Int64.Type}, {\"EducationField\", type text}, {\"EmployeeCount\", Int64.Type}, {\"EmployeeNumber\", Int64.Type}, {\"EnvironmentSatisfaction\", Int64.Type}, {\"Gender\", type text}, {\"HourlyRate\", Int64.Type}, {\"JobInvolvement\", Int64.Type}, {\"JobLevel\", Int64.Type}, {\"JobRole\", type text}, {\"JobSatisfaction\", Int64.Type}, {\"MaritalStatus\", type text}, {\"MonthlyIncome\", Int64.Type}, {\"MonthlyRate\", Int64.Type}, {\"NumCompaniesWorked\", Int64.Type}, {\"OverTime\", type text}, {\"PercentSalaryHike\", Int64.Type}, {\"PerformanceRating\", Int64.Type}, {\"RelationshipSatisfaction\", Int64.Type}, {\"StandardHours\", Int64.Type}, {\"StockOptionLevel\", Int64.Type}, {\"TotalWorkingYears\", Int64.Type}, {\"TrainingTimesLastYear\", Int64.Type}, {\"WorkLifeBalance\", Int64.Type}, {\"YearsAtCompany\", Int64.Type}, {\"YearsInCurrentRole\", Int64.Type}, {\"YearsSinceLastPromotion\", Int64.Type}, {\"YearsWithCurrManager\", Int64.Type}}, \"en-US\"),",
                "    Removed = Table.RemoveColumns(Typed, {\"EmployeeCount\", \"Over18\", \"StandardHours\"}),",
                "    AddFlag = Table.AddColumn(Removed, \"AttritionFlag\", each if [Attrition] = \"Yes\" then 1 else 0, Int64.Type),",
                "    AddAgeBand = Table.AddColumn(AddFlag, \"Age Band\", each if [Age] < 25 then \"18-24\" else if [Age] < 35 then \"25-34\" else if [Age] < 45 then \"35-44\" else if [Age] < 55 then \"45-54\" else \"55+\", type text),",
                "    AddAgeSort = Table.AddColumn(AddAgeBand, \"Age Band Sort\", each if [Age] < 25 then 1 else if [Age] < 35 then 2 else if [Age] < 45 then 3 else if [Age] < 55 then 4 else 5, Int64.Type),",
                "    AddIncBand = Table.AddColumn(AddAgeSort, \"Income Band\", each if [MonthlyIncome] < 3000 then \"< 3K\" else if [MonthlyIncome] < 6000 then \"3K - 6K\" else if [MonthlyIncome] < 10000 then \"6K - 10K\" else if [MonthlyIncome] < 15000 then \"10K - 15K\" else \"15K+\", type text),",
                "    AddIncSort = Table.AddColumn(AddIncBand, \"Income Band Sort\", each if [MonthlyIncome] < 3000 then 1 else if [MonthlyIncome] < 6000 then 2 else if [MonthlyIncome] < 10000 then 3 else if [MonthlyIncome] < 15000 then 4 else 5, Int64.Type),",
                "    AddTenBand = Table.AddColumn(AddIncSort, \"Tenure Band\", each if [YearsAtCompany] < 2 then \"0-1 yrs\" else if [YearsAtCompany] < 5 then \"2-4 yrs\" else if [YearsAtCompany] < 10 then \"5-9 yrs\" else if [YearsAtCompany] < 20 then \"10-19 yrs\" else \"20+ yrs\", type text),",
                "    AddTenSort = Table.AddColumn(AddTenBand, \"Tenure Band Sort\", each if [YearsAtCompany] < 2 then 1 else if [YearsAtCompany] < 5 then 2 else if [YearsAtCompany] < 10 then 3 else if [YearsAtCompany] < 20 then 4 else 5, Int64.Type),",
                "    AddJS = Table.AddColumn(AddTenSort, \"Job Satisfaction Level\", each if [JobSatisfaction]=1 then \"1 - Low\" else if [JobSatisfaction]=2 then \"2 - Medium\" else if [JobSatisfaction]=3 then \"3 - High\" else \"4 - Very High\", type text),",
                "    AddES = Table.AddColumn(AddJS, \"Environment Satisfaction Level\", each if [EnvironmentSatisfaction]=1 then \"1 - Low\" else if [EnvironmentSatisfaction]=2 then \"2 - Medium\" else if [EnvironmentSatisfaction]=3 then \"3 - High\" else \"4 - Very High\", type text),",
                "    AddWLB = Table.AddColumn(AddES, \"Work-Life Balance Level\", each if [WorkLifeBalance]=1 then \"1 - Bad\" else if [WorkLifeBalance]=2 then \"2 - Good\" else if [WorkLifeBalance]=3 then \"3 - Better\" else \"4 - Best\", type text),",
                "    AddTravel = Table.AddColumn(AddWLB, \"Business Travel\", each if [BusinessTravel]=\"Travel_Rarely\" then \"Travels Rarely\" else if [BusinessTravel]=\"Travel_Frequently\" then \"Travels Frequently\" else \"Non-Travel\", type text)",
                "in",
                "    AddTravel"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}